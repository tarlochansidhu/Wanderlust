<% layout('layouts/boilerplate') -%> 
<body>
  <div class="sort">
 <ul class="nav justify-content-center">
  <li class="nav-item">
    <a class="nav-link active" aria-current="page" href="/listings/filter?category=flat">Flats  <i class="fa-solid fa-building"></i></a>
  </li>
  <li class="nav-item">
    <a class="nav-link " href="/listings/filter?category=treehouse">Tree Houses<i class="fa-solid fa-tree-city"></i></a>
  </li>
  <li class="nav-item">
    <a class="nav-link" href="/listings/filter?category=beachhouse">Beach Houses <i class="fa-solid fa-umbrella-beach"></i></a>
  </li>
  <li class="nav-item">
    <a class="nav-link active" aria-current="page" href="/listings/filter?category=cabin">Cabins  <i class="fa-solid fa-building"></i></i></a>
  </li>
  <li class="nav-item">
    <a class="nav-link" href="/listings/filter?category=tinyhouse">Tiny Houses<i class="fa-solid fa-tree-city"></i></a>
  </li>
  <li class="nav-item">
    <a class="nav-link" href="/listings/filter?category=farmhouse">Farm Houses <i class="fa-solid fa-wheat-awn"></i></a>
  </li>
</ul>
</div>
    <h1>Explore Stays</h1>
   <div class="listings">
    <% for (let listing of listings) { %>
       <a href="/listings/<%= listing._id  %>">
        <div class="listing">
        <img src="<%= listing.images[0].url  %>" alt="">
        
          <div class="listingbody">
            <h5 ><%= listing.title %></h5> 
          <h6>&#8377;<%= listing.price %>/night</h6>
          </div>
        

       </div>
       </a>
        
        <% } %>
        </div>
       
</body>
