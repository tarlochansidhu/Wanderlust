<% layout('layouts/boilerplate') -%> 
<body>
 
    <h1></h1>
   <div class="listings">
    <% if (sortedlistings) { %>
      <% for (let listing of sortedlistings) { %>
       <a href="/listings/<%= listing._id  %>">
        <div class="listing">
      <img src="<%= listing.images[0].url %>" alt="">
          <div class="listingbody">
            <h5 ><%= listing.title %></h5> 
          <h6>&#8377;<%= listing.price %>/night</h6>
          </div>
        

       </div>
       </a>
        
        <% } %>

      <% } %>
        </div>
       
</body>
